# SQLite（本機/小型部署可直接使用）
DATABASE_URL="file:./dev.db"

# 部署到正式環境時，若改用 Postgres（Vercel Postgres / Supabase / Railway 等），
# 把上面這行換成類似：
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
# 並同時把 prisma/schema.prisma 中 datasource 的 provider 改成 "postgresql"

# 用來簽署登入 session 的密鑰，正式上線前請換成一串隨機長字串
JWT_SECRET="please-change-this-to-a-long-random-string"
